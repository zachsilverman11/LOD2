# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
# Broad by design: any .env* is ignored unless explicitly allowed below.
# .env.production and .env.vercel were previously tracked and leaked live
# credentials; they are now untracked (still on disk) and covered here.
# This subsumes main's enumerated .env*.local / .env / .env.production / .env.vercel.
.env*
!.env.example
!.env.autonomous-agent.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
prisma/migrations

/app/generated/prisma
test-output/
mailchimp-export.csv
test-pdfs/
