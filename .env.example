# Database
DATABASE_URL="postgresql://user:password@localhost:5432/lod2?schema=public"

# Non-pooled Postgres endpoint. Used by Prisma for migrations ONLY
# (schema.prisma `directUrl`). Must NOT be the -pooler host: DDL run
# through pgbouncer breaks the session state and advisory locks that
# `prisma migrate` depends on. On Neon this is the same connection
# string as DATABASE_URL with the "-pooler" suffix removed from the host.
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# Same non-pooled Neon endpoint, under the name Neon/Vercel provisions it as.
# Read by the standalone production maintenance scripts (check-prod-schema.ts,
# fix-prod-enum.ts).
DATABASE_URL_UNPOOLED="postgresql://user:password@host/database?sslmode=require"

# Webhook Security
WEBHOOK_SECRET="your-webhook-secret-key"

# Cal.com (v2 API)
CALCOM_API_KEY="your-calcom-api-key"
CALCOM_EVENT_TYPE_ID="your-event-type-id"
CALCOM_API_VERSION="2024-09-04"

# YouTube (Greg's Weekly Show @CanadianMortgageshow — trust-building hook)
GREG_YOUTUBE_CHANNEL_ID="your-youtube-channel-id"
GREG_YOUTUBE_CHANNEL_URL="https://www.youtube.com/@CanadianMortgageshow"

# Email (Resend)
RESEND_API_KEY="your-resend-api-key"
FROM_EMAIL="noreply@yourdomain.com"

# SMS (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Voice AI (Vapi.ai)
VAPI_API_KEY="your-vapi-api-key"
VAPI_PHONE_NUMBER_ID="your-phone-number-id"
VAPI_ASSISTANT_ID="your-assistant-id"
# Shared secret Vapi echoes back on each webhook call (assistant serverUrlSecret)
VAPI_WEBHOOK_SECRET="your-vapi-webhook-secret"

# Inngest (Job Queue)
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="your-inngest-signing-key"

# Alt-lending numeric guardrail (Hard Guardrail #8, runtime half).
# Gates the extra content block that runs ONLY for leads in the alt_private
# segment: it rejects any percentage, LTV talk, dollar/fee figure, spelled-out
# figure, or affirmative approval-likelihood claim in an outbound message.
# Complements the always-on alt_private banned-phrase block and the universal
# decimal-rate check; it does not replace either.
# Enabled ONLY by the exact value "on". Unset, empty, "off", "true" = disabled.
HOLLY_ALT_LENDING_GUARDRAILS=off

# App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# CRM (Pipedrive)
PIPEDRIVE_API_TOKEN="your-pipedrive-api-token"
# The "<company>" in <company>.pipedrive.com
PIPEDRIVE_COMPANY_DOMAIN="your-pipedrive-company-domain"

# Plaintext app login password, checked against AUTH_PASSWORD_HASH by
# scripts/test-auth.ts. Local testing only.
AUTH_TEST_PASSWORD="your-app-login-password"
