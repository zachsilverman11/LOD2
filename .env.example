# Database
DATABASE_URL="postgresql://user:password@localhost:5432/lod2?schema=public"

# Non-pooled Postgres endpoint. Used by Prisma for migrations ONLY
# (schema.prisma `directUrl`). Must NOT be the -pooler host: DDL run
# through pgbouncer breaks the session state and advisory locks that
# `prisma migrate` depends on. On Neon this is the same connection
# string as DATABASE_URL with the "-pooler" suffix removed from the host.
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# Webhook Security
WEBHOOK_SECRET="your-webhook-secret-key"

# Cal.com (v2 API)
CALCOM_API_KEY="your-calcom-api-key"
CALCOM_EVENT_TYPE_ID="your-event-type-id"
CALCOM_API_VERSION="2024-09-04"

# YouTube (Greg's Weekly Show @CanadianMortgageshow — trust-building hook)
GREG_YOUTUBE_CHANNEL_ID="your-youtube-channel-id"
GREG_YOUTUBE_CHANNEL_URL="https://www.youtube.com/@CanadianMortgageshow"

# Email (Resend)
RESEND_API_KEY="your-resend-api-key"
FROM_EMAIL="noreply@yourdomain.com"

# SMS (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Voice AI (Vapi.ai)
VAPI_API_KEY="your-vapi-api-key"
VAPI_PHONE_NUMBER_ID="your-phone-number-id"
VAPI_ASSISTANT_ID="your-assistant-id"

# Inngest (Job Queue)
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="your-inngest-signing-key"

# App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
